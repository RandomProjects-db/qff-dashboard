# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Service-role key (SECRET, server-side only). Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password the team types to view the dashboard.
DASHBOARD_PASSWORD=

# Random string used to sign session cookies. Generate a long random value.
SECRET_KEY=
